{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**", "tsconfig*.json", "package.json", "vite.config.ts", "index.html", "tsdown*.config.ts"]
    },
    "check": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "tsconfig*.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
